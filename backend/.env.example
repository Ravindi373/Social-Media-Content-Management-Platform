# Server
PORT=5000

# Database
# For local development (e.g. XAMPP), leave DATABASE_URL blank and use these instead:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smcmp
DB_USER=root
DB_PASS=

# For deployed environments (e.g. Render's managed PostgreSQL), set this
# instead — it takes priority over the DB_* vars above and Sequelize infers
# the dialect (postgres/mysql) from the URL itself.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Meta Graph API (bonus: real social media integration)
# Leave both blank to run in simulated-publish mode (no real Facebook App needed).
# See README.md "Facebook integration" section for how to get these.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v19.0

# AI-assisted caption/hashtag generation (bonus)
# Leave blank to run in simulated (template-based) mode with no API key needed.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
