# Server
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smcmp
DB_USER=root
DB_PASS=

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Meta Graph API (bonus: real social media integration)
# Leave both blank to run in simulated-publish mode (no real Facebook App needed).
# See README.md "Facebook integration" section for how to get these.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v19.0
