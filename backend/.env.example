# Server
PORT=5000

# Database
# Supabase PostgreSQL Connection String
# 1. Go to your Supabase Project Settings -> Database
# 2. Copy the URI from the "Connection string" section (URI tab)
# 3. Replace [YOUR-PASSWORD] with your actual database password
# Example: postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Meta Graph API (bonus: real social media integration)
# Leave both blank to run in simulated-publish mode (no real Facebook App needed).
# See README.md "Facebook integration" section for how to get these.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v19.0

# AI-assisted caption/hashtag generation (bonus)
# Leave blank to run in simulated (template-based) mode with no API key needed.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
